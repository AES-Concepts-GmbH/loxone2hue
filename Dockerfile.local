# Local Development Dockerfile for Loxone2HUE Gateway
# Uses alpine base instead of Home Assistant base for local testing

#---------------------------------------------
# Build stage for Go backend
FROM golang:1.27-alpine AS go-builder

WORKDIR /build
RUN apk add --no-cache git ca-certificates

# Dependencies first, pinned by go.sum
COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY cmd ./cmd
COPY internal ./internal
COPY VERSION ./VERSION

# Build for local architecture
RUN VERSION=$(tr -d '[:space:]' < VERSION) && BUILD_DATE=$(date -u +%Y-%m-%d) && \
    CGO_ENABLED=0 go build -trimpath \
    -ldflags="-w -s -X main.version=${VERSION} -X main.buildTime=${BUILD_DATE}" \
    -o gateway ./cmd/gateway

#---------------------------------------------
# Build stage for frontend
FROM node:22-alpine AS web-builder

WORKDIR /build/web

# Copy package files first for better caching
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund

# Copy source and build
COPY web/ ./
RUN npm run build

#---------------------------------------------
# Final stage
FROM alpine:3.22

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata

WORKDIR /app

# Copy built artifacts
COPY --from=go-builder /build/gateway ./gateway
COPY --from=web-builder /build/web/dist ./web/dist

# Create required directories
RUN mkdir -p /app/configs /data /config/loxone2hue && \
    chmod +x /app/gateway

# Expose port
EXPOSE 8080

# Environment variables
ENV CONFIG_PATH=/app/configs/config.yaml

# Start gateway
CMD ["/app/gateway", "-config", "/app/configs/config.yaml"]
